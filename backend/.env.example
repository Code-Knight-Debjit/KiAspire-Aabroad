# SSL is always enabled in knexfile.js — there is no env var to turn it off.
DATABASE_URL=postgresql://username:password@localhost:5432/kiaspire

JWT_SECRET=mxxxxxxxxxx1xxx3
JWT_EXPIRE=7d

# All four ADMIN_* vars are required — the default admin is skipped entirely
# if any is missing. ADMIN_EMAIL is trimmed and lowercased before it is stored,
# so capitals or stray whitespace here are harmless; log in with the address in
# any casing.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=xxxxxx@gmail.com
ADMIN_PHONE=9876543210
ADMIN_PASSWORD=kyu@123
